{
  "logging_config": {
    "console_output": {
      "enabled": true,
      "level": "INFO",
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
      "date_format": "%Y-%m-%d %H:%M:%S"
    },
    "file_output": {
      "enabled": true,
      "level": "DEBUG",
      "log_dir": "logs",
      "filename": "app.log",
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(filename)s:%(lineno)d - %(message)s",
      "date_format": "%Y-%m-%d %H:%M:%S",
      "max_bytes": 10485760,
      "backup_count": 5
    }
}
}
